# Environment Mode: 'development' or 'production'
FLASK_ENV=development

# Application Secret Key (must be a random 32+ character string in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# Database Mode: 'sqlite' (local development/tests) or 'turso' (production/hosted libSQL)
DATABASE_MODE=sqlite

# Local SQLite Configuration (used when DATABASE_MODE=sqlite)
SQLITE_DATABASE_PATH=data/tracker.db

# Turso Cloud Configuration (required when DATABASE_MODE=turso or on Vercel)
# TURSO_DATABASE_URL format: libsql://<your-database-name>-<org>.turso.io or https://...
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Application Display Currency (e.g., INR, USD, EUR)
BASE_CURRENCY=INR(₹)

# Currency Conversion API (default: https://api.frankfurter.app/latest)
EXCHANGE_API_URL=https://api.frankfurter.app/latest

# Flask Debug Flag (0 = off, 1 = on)
FLASK_DEBUG=0
