# Environment Mode: 'development' or 'production'
FLASK_ENV=development

# Application Secret Key (must be a random 32+ character string in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

# Database Mode: 'sqlite' (local development & Railway volume) or 'turso' (hosted libSQL on Vercel)
DATABASE_MODE=sqlite

# SQLite Storage Configuration:
# - Local Development: DATABASE_PATH=data/tracker.db
# - Railway Production (Mounted Volume): DATABASE_PATH=/data/expenses.db
DATABASE_PATH=data/tracker.db
# Backward-compatible alias for local development
SQLITE_DATABASE_PATH=data/tracker.db

# Turso Cloud Configuration (required when DATABASE_MODE=turso or on Vercel)
# TURSO_DATABASE_URL format: libsql://<your-database-name>-<org>.turso.io or https://...
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Designated Administrator Email (optional: automatically assigned admin role upon registration)
# ADMIN_EMAIL=admin@example.com

# Application Display Currency (e.g., INR, USD, EUR)
BASE_CURRENCY=INR(₹)

# Currency Conversion API (default: https://api.frankfurter.app/latest)
EXCHANGE_API_URL=https://api.frankfurter.app/latest

# Flask Debug Flag (0 = off, 1 = on)
FLASK_DEBUG=0

# Rate Limiting Configuration
# RATE_LIMIT_STORAGE_URL: Redis URL for distributed rate limiting (e.g., redis://localhost:6379/0)
# If not set, uses in-memory storage (suitable for single-instance deployments only)
# RATE_LIMIT_STORAGE_URL=

# Trust X-Forwarded-For header for client IP detection behind reverse proxy (Railway, Vercel, etc.)
# Set to 'true' when deployed behind a trusted reverse proxy
# RATE_LIMIT_TRUSTED_PROXY=false

# Enable/disable rate limiting entirely (default: true)
# RATE_LIMIT_ENABLED=true

# Logging Configuration
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
# LOG_FORMAT: 'json' for structured logging, 'text' for human-readable
# LOG_FORMAT=json

# Sentry Configuration (optional)
# SENTRY_DSN=https://your-key@sentry.io/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Backup Configuration
# BACKUP_DIR: Directory to store backup files (default: ./backups)
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS: Number of days to keep backups (default: 7)
# BACKUP_RETENTION_DAYS=7
